<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MSD ALPHA ALONE - Wallet Shield</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0b0e11; color: #f0b90b; padding: 15px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #22252a; padding-bottom: 10px; }
        .header h1 { font-size: 1.2rem; color: #f0b90b; letter-spacing: 1px; }
        .shield-status { background: #1e2329; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; color: #0ecb81; border: 1px solid #0ecb8133; }
        .card { background: #1e2329; border-radius: 12px; padding: 15px; margin-bottom: 15px; border: 1px solid #2b313a; }
        .card h3 { font-size: 0.95rem; color: #fff; margin-bottom: 12px; }
        .input-group { margin-bottom: 12px; }
        .input-group label { display: block; font-size: 0.75rem; color: #848e9c; margin-bottom: 5px; text-transform: uppercase; }
        .input-group input { width: 100%; background: #0b0e11; border: 1px solid #2b313a; color: #fff; padding: 10px; border-radius: 6px; font-size: 0.95rem; }
        .metrics-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }
        .metric-box { background: #0b0e11; padding: 10px; border-radius: 8px; border: 1px solid #2b313a; }
        .metric-title { font-size: 0.7rem; color: #848e9c; }
        .metric-value { font-size: 1.1rem; color: #fff; font-weight: bold; margin-top: 4px; }
        .metric-value.safe { color: #0ecb81; }
        .metric-value.danger { color: #f6465d; }
        .btn { width: 100%; background: #f0b90b; color: #000; border: none; padding: 12px; border-radius: 8px; font-weight: bold; font-size: 1rem; cursor: pointer; margin-top: 5px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>MSD ALPHA ALONE</h1>
        <div class="shield-status">🛡️ SHIELD: ACTIVE</div>
    </div>
    <div class="card">
        <h3>⚡ Wallet Shield & Risk Calculator</h3>
        <div class="input-group">
            <label>Wallet Balance (USDT)</label>
            <input type="number" id="walletBal" value="1000" oninput="calc()">
        </div>
        <div class="input-group">
            <label>Risk Per Trade (%)</label>
            <input type="number" id="riskPct" value="1" step="0.1" oninput="calc()">
        </div>
        <div class="metrics-grid">
            <div class="metric-box">
                <div class="metric-title">Max Allowable Loss</div>
                <div class="metric-value danger" id="maxLoss">$10.00</div>
            </div>
            <div class="metric-box">
                <div class="metric-title">Safe Max Leverage</div>
                <div class="metric-value safe" id="safeLev">10x</div>
            </div>
        </div>
    </div>
    <button class="btn" onclick="alert('🛡️ MSD ALPHA SHIELD ENGAGED!')">LOCK SETUP & DEPLOY SHIELD</button>

    <script>
        function calc() {
            let bal = parseFloat(document.getElementById('walletBal').value) || 0;
            let riskP = parseFloat(document.getElementById('riskPct').value) || 0;
            let maxLossVal = bal * (riskP / 100);
            document.getElementById('maxLoss').innerText = '$' + maxLossVal.toFixed(2);
        }
    </script>
</body>
</html>
